ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PORT=3300

# Auth: set a strong secret in production (else one is generated to auth/.secret).
SESSION_SECRET=
# Optional: enables real "Sign in with Google" (else a demo button is shown).
GOOGLE_CLIENT_ID=

# Supabase (optional). When both are set, projects + users are stored in
# Supabase Postgres instead of local files. Use the SERVICE ROLE key —
# server-side only, never expose it to the browser. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protect the HTTP MCP endpoint (/mcp) with a bearer token.
MCP_HTTP_TOKEN=
